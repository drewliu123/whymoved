    ],
    "findings": [
      {
        "claim_ids": [
          "C1",
          "C2",
          "C6"
        ],
        "increment": {
          "baseline": "媒体 headline 投入规模",
          "detail": "与现金流原表和租赁开始确认机制关联。",
          "kind": "connection"
        },
        "text": "电话会解释融资租赁在开始时确认全部价值。GeekWire 也以 24.2B 描述投资规模；做现金压力或跨公司比较时，须回到现金流表，统一期间、单位及租赁处理。",
        "title": "24.2B 是投入确认口径，17.079B 是现金 PP&E",
        "why_it_matters": "用 headline capex 直接扣 CFO 会把新租赁的确认与当期支付混用。"
      },
      {
        "calculation_ids": [
          "K1",
          "K2"
        ],
        "claim_ids": [
          "C1",
          "C2",
          "C3",
          "C4"
        ],
        "increment": {
          "baseline": "差额全是新融资租赁的假设",
          "detail": "原披露值计算后不相等，拒绝伪调节。",
          "kind": "calculation"
        },
        "text": "24.2 − 17.079 ≈ 7.121；再扣 6.5 后约 0.621。因 24.2 和 6.5 已四舍五入，这些差值也是近似数。年报披露 PP&E 应付款，只能提示支付时点可能影响桥接，不能证明本季度残差的具体组成。",
        "title": "差额约 7.121B，仍有约 0.621B 未调节",
        "why_it_matters": "保留未解释残差，避免把一个算术差额包装成新增融资租赁事实。"
      },
      {
        "calculation_ids": [
          "K3",
          "K4"
        ],
        "claim_ids": [
          "C4",
          "C5"
        ],
        "increment": {
          "baseline": "仅看 CFO 减 cash PP&E",
          "detail": "增加同期间租赁本金后的剩余现金展示，同时隔离未来义务。",
          "kind": "calculation"
        },
        "text": "FY2025 全年示例：CFO 136.162 − cash PP&E 64.551 = 71.611B；再扣年报的融资租赁融资现金流 2.283 = 69.328B。这是分析口径，且全部采用全年数据。已含在 CFO 的 1.372B 融资租赁经营现金流不要再扣。未开始租赁 92.7B 是未来义务线索，不能计作这一年的现金支出。",
        "title": "当期现金还要看融资租赁本金；未来义务另列",
        "why_it_matters": "同时避免漏计租赁本金和重复扣经营现金项。"
      }
    ],

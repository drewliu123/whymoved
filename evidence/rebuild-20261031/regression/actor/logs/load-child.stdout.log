      {
        "access_status": "ok",
        "evidence_kind": "document",
        "id": "S4",
        "locator": "source-material/S4/page.txt:71",
        "origin_basis": "Unresolved in schema 1; publisher and URL are not proof of independent origin.",
        "origin_id": null,
        "provenance": {
          "claim_ids": [
            "C3",

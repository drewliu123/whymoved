<style id="wp-custom-css">
html {
  scroll-behavior: smooth;
}

@media (max-width: 768px) {
  #newsletter-subscribe-sidebar {
    display: none;
  }
}

/* Hide "Read More" links inside sponsored posts */
article.sponsor_post .entry-summary > a:last-child {
  display: none !important;
}

/* GeekWire Calendar header cleanup (calendar + single event pages) */
.tribe-events-l-container:has(.event-calendar-header) {
  padding-top: 2rem !important;
}
.row:has(> .col-md-8 > .event-calendar-header) {
  align-items: center;
  padding-bottom: 1.5rem;
  margin-bottom: 2rem;
  border-bottom: 1px solid #e2e2e2;
}
.col-md-8:has(> .event-calendar-header) {
  padding-right: 3rem !important;
}
@media (max-width: 767px) {
  .col-md-8:has(> .event-calendar-header) {
    padding-right: 15px !important;
  }
}
.event-calendar-header {
  font: 700 2.25rem/1.15 Roboto, sans-serif !important;
  color: #141827 !important;
  margin: 0 0 .6rem !important;
}
.col-md-8:has(> .event-calendar-header) p {
  font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 16px !important;
  line-height: 1.6 !important;
  color: #41474f !important;
  margin: 0 0 1.1rem !important;
  max-width: 640px;
}
.col-md-8:has(> .event-calendar-header) p strong {
  color: #141827;
}
.col-md-8:has(> .event-calendar-header) p a {
  color: #be4825 !important;
  text-decoration: underline !important;
}
.col-md-8:has(> .event-calendar-header) .text-center {
  text-align: left !important;
}
.col-md-8:has(> .event-calendar-header) a.btn-primary {
  display: inline-block !important;
  background: #be4825 !important;
  border: 0 !important;
  color: #fff !important;
  font: 600 15px/1 Roboto, sans-serif !important;
  padding: 12px 20px !important;
  border-radius: 4px !important;
  text-decoration: none !important;
}
.col-md-8:has(> .event-calendar-header) a.btn-primary:hover {
  background: #9e3b1e !important;
}
.col-md-4:has(> #ad-gw-calendar) {
  display: flex;
  justify-content: flex-end;
}
@media (max-width: 767px) {
  .col-md-4:has(> #ad-gw-calendar) {
    justify-content: center;
    margin-top: 1.25rem;
  }
}

/* Calendar intro: drop the "Look for highlights" sentence (text is hard-coded in the theme, so the paragraph is rebuilt with CSS) */
.col-md-8:has(> .event-calendar-header) p {
  font-size: 0 !important;
}
.col-md-8:has(> .event-calendar-header) p strong,
.col-md-8:has(> .event-calendar-header) p a,
.col-md-8:has(> .event-calendar-header) p::after {
  font-size: 16px;
}
.col-md-8:has(> .event-calendar-header) p strong::after {
  content: " Browse for local tech events, or search by date or keyword. Submit your event below for consideration for the GeekWire Calendar. Look for highlights from the GeekWire Calendar every Saturday morning in the GeekWire newsletter. Check out GeekWire's own unique series of ";
  font-weight: 400;
  color: #41474f;
}
.col-md-8:has(> .event-calendar-header) p::after {
  content: " in the Seattle region.";
}

/* Startup submission form: theme rule ".ginput_container input" stretched radios/checkboxes into full-width bars. Restore native controls. */
.ginput_container input[type="radio"],
.ginput_container input[type="checkbox"] {
  appearance: auto;
  width: auto;
  padding: 0;
  margin: 0 .5rem 0 0;
  border-radius: 0;
  vertical-align: middle;
}

</style>

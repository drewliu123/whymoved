{
  "schema_version": 2,
  "title": "FOMC 不是方向事件：会后正收益在基准与 beta 下消失",
  "question": "FOMC 决议日后 3 个交易日，标普 500 有稳定方向吗？",
  "type": "asset",
  "task": "参考类事件研究",
  "as_of": "2026-11-14T00:00:00Z",
  "answer": {
    "text": "2024 年 8 次 FOMC 后窗 6/8 为正、中位 +1.35%，但 7 月 31 日单次 −6.1% 把均值压到 +0.5% 以下；相对纳斯达克超额中位 −0.33%（为正仅 25%），beta 调整后接近零，beta 在 0.5–0.9 之间符号翻转。结论：FOMC 不是方向事件，绝对收益主要来自市场 beta；样本只有 8 次、同一政策周期，不能外推。",
    "claim_ids": [
      "I-JUDGE",
      "B1",
      "B8",
      "D1",
      "D8"
    ]
  },
  "findings": [
    {
      "title": "6/8 为正，但尾部很重",
      "text": "8 次样本中 6 次事件后为正；7 月 31 日事件后 3 个观测点下跌约 6.1%，把均值压到接近零。",
      "claim_ids": [
        "C13",
        "C15",
        "C19",
        "C21"
      ],
      "why_it_matters": "只看正样本占比会忽略单次尾部，而尾部正是仓位与风险管理的核心。",
      "increment": {
        "kind": "contradiction",
        "baseline": "FOMC 后偏涨的印象",
        "detail": "尾部样本改变均值与风险判断"
      }
    },
    {
      "title": "绝对收益为正，但相对纳斯达克是负超额",
      "text": "后窗绝对收益中位 +1.35%；相对纳斯达克为 −0.33%，相对道指为 +0.37%，基准不同结论不同。",
      "claim_ids": [
        "C1",
        "C24",
        "I-JUDGE",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5",
        "B6",
        "B7",
        "B8",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6",
        "D7",
        "D8"
      ],
      "why_it_matters": "绝对收益可能是市场整体上涨；加基准后仍要先问「对哪个基准」。",
      "increment": {
        "kind": "connection",
        "baseline": "把事件后上涨归因于事件",
        "detail": "区分市场漂移与事件效应"
      }
    },
    {
      "title": "样本太小，且在同一政策周期",
      "text": "8 次会议不足以形成稳定分布，也无法覆盖不同利率环境。",
      "claim_ids": [
        "C25",
        "I-JUDGE"
      ],
      "why_it_matters": "参考类的价值取决于样本广度；同一周期的事件不能外推到所有环境。",
      "increment": {
        "kind": "new_fact",
        "baseline": "把 8 次样本当一般规律",
        "detail": "事件类型与周期单一"
      }
    },
    {
      "title": "结论对基准与 beta 都敏感",
      "text": "简单超额：纳斯达克 −0.33%（25% 为正）、道指 +0.37%（75%）；按 beta 调整后：纳斯达克约 +0.05%（75%）、道指约 +0.45%（75%）。方向与幅度随基准和 beta 变化。",
      "claim_ids": [
        "B1",
        "B8",
        "D1",
        "D8",
        "I-JUDGE"
      ],
      "why_it_matters": "只报一种口径，等于把基准与 beta 选择藏在结论里；三种口径并列才能说明「效应不稳定」。",
      "increment": {
        "kind": "contradiction",
        "baseline": "绝对收益口径",
        "detail": "简单超额口径"
      }
    },
    {
      "title": "beta 敏感性：纳斯达克超额跨零",
      "text": "beta 0.5 / 0.673 / 0.9 对应纳斯达克后窗超额中位 +0.42% / +0.05% / −0.24%；道指在 0.7–1.1 之间为 +0.76% / +0.45% / +0.33%，始终为正。",
      "claim_ids": [
        "B1",
        "B8",
        "D1",
        "D8"
      ],
      "why_it_matters": "beta 是估计值，不是常数；只报一个 beta 的点估计，会把「符号翻转」藏起来。",
      "increment": {
        "kind": "new_fact",
        "baseline": "单一 beta 点估计",
        "detail": "beta 区间扫描"
      }
    }
  ],

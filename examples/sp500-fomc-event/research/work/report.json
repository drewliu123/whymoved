{
  "schema_version": 2,
  "title": "FOMC 事件研究：样本扩到 16 次，基准调整后效应趋零",
  "question": "FOMC 决议日后 3 个交易日，标普 500 有稳定方向吗？",
  "type": "asset",
  "task": "参考类事件研究",
  "as_of": "2026-11-14T00:00:00Z",
  "answer": {
    "text": "2024 与 2025 各 8 次 FOMC：绝对后窗中位 +1.35% 与 +0.45%，合并 +1.19%（62.5% 为正）；但基准超额在 2025 年接近零（纳斯达克 −0.10%、道指 +0.09%），2024 年的负/正超额没有复现。beta 调整后合并纳斯达克 +0.05%、道指 +0.31%。结论：绝对收益有正偏，但基准调整后效应不稳定，样本扩展后趋零；FOMC 不是可靠的方向事件。",
    "claim_ids": [
      "I-JUDGE",
      "N25-01-EVENT",
      "N25-08-EVENT",
      "B25-01",
      "D25-01"
    ]
  },
  "findings": [
    {
      "title": "2025 绝对收益低于 2024",
      "text": "后窗绝对中位 +1.35%（2024）→+0.45%（2025）；为正比例 75%→50%。",
      "claim_ids": [
        "I-JUDGE",
        "N25-01-EVENT",
        "N25-08-EVENT"
      ],
      "why_it_matters": "同一事件在另一年没有复现同样的正偏；单年样本会高估效应。",
      "increment": {
        "kind": "judgment_update",
        "baseline": "2024 绝对收益正偏",
        "detail": "2025 降至 +0.45%"
      }
    },
    {
      "title": "2025 基准超额接近零",
      "text": "纳斯达克简单超额中位 −0.10%（25% 为正）、道指 +0.09%；2024 年为 −0.33%/+0.37%。",
      "claim_ids": [
        "N25-01-EVENT",
        "B25-01",
        "D25-01",
        "I-JUDGE"
      ],
      "why_it_matters": "基准调整后的方向不稳定，2024 的结论不能外推到 2025。",
      "increment": {
        "kind": "contradiction",
        "baseline": "基准超额稳定",
        "detail": "2025 接近零"
      }
    },
    {
      "title": "合并 16 次：绝对正偏、超额趋零",
      "text": "绝对中位 +1.19%、62.5% 为正；纳斯达克简单超额约 0.00%、道指 +0.24%；beta 调整后 +0.05%/+0.31%。",
      "claim_ids": [
        "I-JUDGE",
        "N25-01-EVENT",
        "B25-01",
        "D25-01"
      ],
      "why_it_matters": "样本翻倍后效应被拉回零，支持「无稳定事件效应」。",
      "increment": {
        "kind": "connection",
        "baseline": "8 次样本",
        "detail": "16 次样本趋零"
      }
    },
    {
      "title": "beta 敏感性收窄",
      "text": "16 次样本：纳斯达克 beta 0.5/0.9 对应 +0.11%/+0.02%；道指 0.7/1.1 对应 +0.38%/+0.25%。",
      "claim_ids": [
        "I-JUDGE",
        "B25-01",
        "D25-01"
      ],
      "why_it_matters": "样本扩大后，beta 选择不再让符号翻转，但效应本身接近零。",
      "increment": {
        "kind": "new_fact",
        "baseline": "8 次样本 beta 跨零",
        "detail": "16 次样本区间收窄"
      }
    }
  ],

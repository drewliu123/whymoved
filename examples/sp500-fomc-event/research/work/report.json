      ],
      "why_it_matters": "绝对收益可能是市场整体上涨；加基准后仍要先问「对哪个基准」。",
      "increment": {
        "kind": "connection",
        "baseline": "把事件后上涨归因于事件",
        "detail": "区分市场漂移与事件效应"
      }
    },
    {
      "title": "样本太小，且在同一政策周期",
      "text": "8 次会议不足以形成稳定分布，也无法覆盖不同利率环境。",
      "claim_ids": [
        "C25",
        "I-JUDGE"
      ],
      "why_it_matters": "参考类的价值取决于样本广度；同一周期的事件不能外推到所有环境。",
      "increment": {
        "kind": "new_fact",
        "baseline": "把 8 次样本当一般规律",
        "detail": "事件类型与周期单一"
      }
    },
    {
      "title": "基准选择改变方向",
      "text": "相对纳斯达克后窗超额中位约 −0.33%、为正 25%；相对道指约 +0.37%、为正 75%。同一批事件，两个基准给出相反方向。",
      "claim_ids": [
        "B1",
        "B8",
        "D1",
        "D8",
        "I-JUDGE"
      ],
      "why_it_matters": "超额的方向取决于基准；只报一个基准的超额，等于把基准选择藏在结论里。",
      "increment": {
        "kind": "contradiction",
        "baseline": "绝对收益口径",
        "detail": "简单超额口径"
      }
    }
